{
  "manifest_version": 3,
  "name": "Chat Relay Wake Prototype",
  "version": "0.8.0",
  "description": "Routes Discord relay and autonomous harness work to separate configured ChatGPT tasks.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "send-attested-message": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Send the current owner message with attestation"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Chat Relay Wake",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
