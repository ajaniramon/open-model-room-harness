# Required
DISCORD_TOKEN=

# Primary conversation provider: nanogpt, openai, anthropic, xai, or gemini
MODEL_PROVIDER=nanogpt

# Configure the key and model for the selected provider.
# NanoGPT is also used by the optional image, vision, and built-in escalation routes.
NANOGPT_API_KEY=
NANOGPT_MODEL=xiaomi/mimo-v2.5-pro:thinking
NANOGPT_BASE_URL=https://nano-gpt.com/api/subscription/v1/chat/completions

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional integrations
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Bot routing
JJ_TRIGGER_MODE=mention
JJ_ALLOWED_CHANNEL_IDS=
JJ_RESPOND_TO_BOTS=false
JJ_BLOCKED_USERNAMES=
JJ_VISUAL_IDENTITY=

# Owner-only capabilities. Discord user IDs are strongly preferred.
JJ_WEB_ALLOWED_USER_IDS=
JJ_WEB_ALLOWED_USERNAMES=
JJ_AUDIO_ALLOWED_USER_IDS=
JJ_AUDIO_ALLOWED_USERNAMES=
JJ_IMAGE_ALLOWED_USER_IDS=
JJ_IMAGE_ALLOWED_USERNAMES=
JJ_CODEX_ALLOWED_USER_IDS=
JJ_CODEX_ALLOWED_USERNAMES=
JJ_ESCALATION_ALLOWED_USER_IDS=
JJ_ESCALATION_ALLOWED_USERNAMES=

# Audio
JJ_AUDIO_MODE_STATE_PATH=state/audio-mode.json
JJ_AUDIO_MAX_CHARS=1200
JJ_AUDIO_MAX_BYTES=8000000
ELEVENLABS_TIMEOUT_MS=60000

# Image generation and prompt expansion
NANOGPT_IMAGE_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_IMAGE_MODEL=gpt-image-2
NANOGPT_IMAGE_PROMPT_MODEL=qwen3.7-flash:thinking
NANOGPT_IMAGE_PROMPT_BASE_URL=https://nano-gpt.com/api/v1/chat/completions
NANOGPT_IMAGE_TIMEOUT_MS=180000
JJ_IMAGE_MAX_PROMPT_CHARS=3000
JJ_IMAGE_MAX_BYTES=10000000

# Vision
NANOGPT_VISION_MODEL=qwen3.7-flash:thinking
NANOGPT_VISION_BASE_URL=https://nano-gpt.com/api/v1/chat/completions
NANOGPT_VISION_TIMEOUT_MS=90000
JJ_VISION_MAX_IMAGES=4
JJ_VISION_MAX_BYTES=8000000
JJ_VISION_MAX_OUTPUT_TOKENS=1200

# Codex delegation
JJ_CODEX_WORKSPACE=codex-workspace
# Exact owner-only command: @JJ CODEX YOLO :: <task>
JJ_CODEX_YOLO_ENABLED=false
JJ_CODEX_YOLO_WORKSPACE=
JJ_CODEX_TIMEOUT_MS=600000
JJ_CODEX_MAX_TASK_CHARS=8000
JJ_CODEX_MAX_RESULT_CHARS=30000

# General limits
JJ_ESCALATION_MAX_OUTPUT_TOKENS=12000
JJ_CONTEXT_MESSAGES=24
JJ_MAX_OUTPUT_TOKENS=4096
JJ_REASONING_EFFORT=high
JJ_API_TIMEOUT_MS=120000
JJ_MAX_TOOL_ITERATIONS=4

# Optional organic participation
JJ_SPONTANEOUS_ENABLED=true
JJ_SPONTANEOUS_MIN_MESSAGES=8
JJ_SPONTANEOUS_MAX_MESSAGES=24
JJ_SPONTANEOUS_COOLDOWN_MINUTES=20
JJ_SPONTANEOUS_MAX_PER_HOUR=2
JJ_SPONTANEOUS_MIN_CHARS=12
