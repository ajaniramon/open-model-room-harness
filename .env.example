# Required
DISCORD_TOKEN=
# Optional Discord-only custom emoji strings. These are runtime metadata, not memory or a signature.
DISCORD_EMOJI_PALETTE="<:example_one:123456789012345678>,<a:example_two:234567890123456789>"

# Primary conversation provider: nanogpt, openai, anthropic, xai, gemini, or local
MODEL_PROVIDER=nanogpt

# Optional fallback for the default conversation route. When the primary
# inference call fails after its retry, the turn is repeated once here instead
# of posting an error message. Leave the provider empty to disable. Model and
# base URL default to the fallback provider's configured values.
MODEL_FALLBACK_PROVIDER=
MODEL_FALLBACK_MODEL=
MODEL_FALLBACK_BASE_URL=

# Configure the key and model for the selected provider.
# NanoGPT is also used by the optional image, vision, and built-in escalation routes.
NANOGPT_API_KEY=
NANOGPT_MODEL=xiaomi/mimo-v2.5-pro:thinking
NANOGPT_BASE_URL=https://nano-gpt.com/api/subscription/v1/chat/completions

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible local server (llama.cpp, vLLM, or equivalent).
# LOCAL_API_KEY is optional. LOCAL_BASE_URL may be the host, /v1 base, or full
# /v1/chat/completions URL; the harness normalizes it automatically.
LOCAL_API_KEY=
LOCAL_MODEL=local-model
LOCAL_BASE_URL=http://127.0.0.1:8080/v1

# Optional integrations
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Bot routing
JJ_TRIGGER_MODE=mention
# Server IDs go here.
JJ_ALLOWED_GUILD_IDS=
# Channel IDs go here for a channel-only focus lock.
JJ_ALLOWED_CHANNEL_IDS=
# Bot message policy. In allowlist mode only listed bot IDs are accepted; in
# blocklist mode every bot except the listed IDs is accepted. Permitted bots
# still need a Discord mention or a bounded match of this bot's display/name.
JJ_BOT_FILTER_MODE=allowlist
JJ_BOT_USER_IDS=
# Per-channel circuit breaker for permitted bots. Five qualifying bot turns are
# allowed, then further bot triggers pause until cooldown or a human message.
JJ_BOT_LOOP_GUARD_ENABLED=true
JJ_BOT_LOOP_GUARD_MAX_CONSECUTIVE=5
JJ_BOT_LOOP_GUARD_COOLDOWN_SECONDS=180
# Legacy compatibility. Prefer JJ_BOT_FILTER_MODE and JJ_BOT_USER_IDS.
JJ_RESPOND_TO_BOTS=false
JJ_ALLOWED_BOT_USER_IDS=
JJ_BLOCKED_USERNAMES=
JJ_OWNER_USER_IDS=
JJ_OWNER_USERNAMES=
JJ_VISUAL_IDENTITY=

# Optional Discord connectivity watchdog. Enable only when an external supervisor
# will restart exit code 75 (for example systemd, WinSW, Docker, or PM2).
DISCORD_WATCHDOG_ENABLED=false
DISCORD_WATCHDOG_GRACE_SECONDS=90
DISCORD_WATCHDOG_CHECK_INTERVAL_SECONDS=15

# Owner-only capabilities. Discord user IDs are strongly preferred.
JJ_WEB_ALLOWED_USER_IDS=
JJ_WEB_ALLOWED_USERNAMES=
JJ_AUDIO_ALLOWED_USER_IDS=
JJ_AUDIO_ALLOWED_USERNAMES=
JJ_IMAGE_ALLOWED_USER_IDS=
JJ_IMAGE_ALLOWED_USERNAMES=
JJ_CODEX_ALLOWED_USER_IDS=
JJ_CODEX_ALLOWED_USERNAMES=
JJ_ESCALATION_ALLOWED_USER_IDS=
JJ_ESCALATION_ALLOWED_USERNAMES=

# Audio
JJ_AUDIO_MODE_STATE_PATH=state/audio-mode.json
JJ_AUDIO_MAX_CHARS=1200
JJ_AUDIO_MAX_BYTES=8000000
ELEVENLABS_TIMEOUT_MS=60000

# Image generation and prompt expansion
NANOGPT_IMAGE_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_IMAGE_MODEL=gpt-image-2
NANOGPT_IMAGE_PROMPT_MODEL=qwen3.7-flash:thinking
NANOGPT_IMAGE_PROMPT_BASE_URL=https://nano-gpt.com/api/v1/chat/completions
NANOGPT_IMAGE_TIMEOUT_MS=180000
JJ_IMAGE_MAX_PROMPT_CHARS=3000
JJ_IMAGE_MAX_BYTES=10000000

# Vision
NANOGPT_VISION_MODEL=qwen3.7-flash:thinking
NANOGPT_VISION_BASE_URL=https://nano-gpt.com/api/v1/chat/completions
NANOGPT_VISION_TIMEOUT_MS=90000
JJ_VISION_MAX_IMAGES=4
JJ_VISION_MAX_BYTES=8000000
JJ_VISION_MAX_OUTPUT_TOKENS=1200
# sidecar: inspect images with the bounded vision model above. native: attach the
# triggering images directly, but only for exact allowlisted multimodal chat models.
# Every configured fallback must also be OpenAI-compatible and allowlisted.
JJ_VISION_MODE=sidecar
JJ_VISION_NATIVE_MODELS=

# X/Twitter link prefetch
# Download posts linked in a message before answering, so the bot can comment on them
# without calling a tool. Applies to anyone in a channel it answers in; owner-only in DMs.
JJ_X_PREFETCH_ENABLED=true
JJ_X_PREFETCH_MAX_POSTS=2
JJ_X_PREFETCH_MAX_CHARS=1200

# Generic web-page prefetch: bare http(s) links from web-authorized identities are
# downloaded through Tavily Extract and attached to the triggering message, so
# dropping a URL works without an explicit "read/fetch" request. Requires
# TAVILY_API_KEY. DMs stay owner-only; GIF/media and X hosts are skipped.
JJ_WEB_PREFETCH_ENABLED=true
JJ_WEB_PREFETCH_MAX_URLS=2
JJ_WEB_PREFETCH_MAX_CHARS=3000

# Codex delegation
JJ_CODEX_WORKSPACE=codex-workspace
# Exact owner-only command: @YourBot CODEX YOLO :: <task>
JJ_CODEX_YOLO_ENABLED=false
JJ_CODEX_YOLO_WORKSPACE=
JJ_CODEX_TIMEOUT_MS=600000
JJ_CODEX_MAX_TASK_CHARS=8000
JJ_CODEX_MAX_RESULT_CHARS=30000

# General limits
JJ_ESCALATION_MAX_OUTPUT_TOKENS=12000
JJ_CONTEXT_MESSAGES=24
# Prefix every context message with when it was posted and how old it is.
# JJ_TIME_ZONE takes an IANA name; leave it empty to use the host time zone.
JJ_CONTEXT_TIMESTAMPS=true
JJ_TIME_ZONE=

# Cross-channel memory. OFF by default: it stores content from a shared room, so
# read README section 'Memory' for the obligations you take on before enabling it.
# Only the identities below may store, list or delete notes.
JJ_MEMORY_ENABLED=false
JJ_MEMORY_ALLOWED_USER_IDS=
JJ_MEMORY_ALLOWED_USERNAMES=
JJ_MEMORY_STORE_PATH=state/memory.jsonl
JJ_MEMORY_MAX_RECORDS=5000
JJ_MEMORY_MAX_PER_USER=300
JJ_MEMORY_RETENTION_DAYS=90
JJ_MEMORY_MAX_TEXT_CHARS=300
JJ_MEMORY_INJECTION_MAX_ITEMS=60
JJ_MEMORY_INJECTION_MAX_CHARS=12000
# Passive capture is a second switch. With it off, only explicit owner commands
# write memory. 'observation' captures only in observation mode; 'always' also
# captures during normal operation. Maintenance always freezes capture.
JJ_MEMORY_EXTRACTION_ENABLED=false
JJ_MEMORY_CAPTURE_MODE=observation
# Empty provider/model/baseUrl fall back to the main conversation route.
JJ_MEMORY_EXTRACTION_PROVIDER=
JJ_MEMORY_EXTRACTION_MODEL=
JJ_MEMORY_EXTRACTION_BASE_URL=
JJ_MEMORY_EXTRACTION_IDLE_MINUTES=10
JJ_MEMORY_EXTRACTION_MIN_MESSAGES=4
JJ_MEMORY_EXTRACTION_MAX_MESSAGES=40
JJ_MEMORY_EXTRACTION_MAX_CHARS=8000
JJ_MEMORY_EXTRACTION_MAX_FACTS=5
JJ_MEMORY_EXTRACTION_MAX_OUTPUT_TOKENS=800
JJ_MEMORY_EXTRACTION_CHECK_SECONDS=60
JJ_MEMORY_AUDIT_ENABLED=true
JJ_MEMORY_AUDIT_PATH=logs/memory-events.jsonl

JJ_MAX_OUTPUT_TOKENS=4096
JJ_REASONING_EFFORT=high
JJ_API_TIMEOUT_MS=120000

# Optional provider-free ChatGPT relay. Image references stay in the private
# relay state and are fetched only through the authenticated MCP attachment tool.
CHAT_RELAY_ENABLED=false
CHAT_RELAY_STATE_PATH=state/chat-relay.json
CHAT_RELAY_TTL_SECONDS=86400
CHAT_RELAY_MAX_ITEMS=50
CHAT_RELAY_MAX_CONTEXT_CHARS=12000
CHAT_RELAY_LEASE_SECONDS=120
CHAT_RELAY_MAX_ATTEMPTS=3
CHAT_RELAY_OWNER_PRIORITY_BURST=3
CHAT_RELAY_HUMAN_PRIORITY_BURST=5
CHAT_RELAY_MAX_IMAGE_ATTACHMENTS=4
CHAT_RELAY_MAX_AUDIO_ATTACHMENTS=2
CHAT_RELAY_MAX_TEXT_ATTACHMENTS=4
CHAT_RELAY_MAX_ATTACHMENT_BYTES=8000000
CHAT_RELAY_MAX_AUDIO_ATTACHMENT_BYTES=8000000
CHAT_RELAY_AUDIO_FETCH_TIMEOUT_MS=30000

# Optional capability broker integration for relay claims. Keep disabled until
# the broker and audience gateways are configured. Tokens belong in secrets.env.
CAPABILITY_BROKER_ENABLED=false
CAPABILITY_BROKER_URL=http://127.0.0.1:3400
CAPABILITY_BROKER_OWNER_AUDIENCES=filesystem,execution,discord
CAPABILITY_BROKER_PUBLIC_AUDIENCES=discord
CAPABILITY_BROKER_AUTONOMOUS_AUDIENCES=filesystem,execution,discord
CAPABILITY_BROKER_TIMEOUT_MS=5000
CAPABILITY_BROKER_MIN_GRANT_REMAINING_SECONDS=15
BROKER_DISCORD_INGRESS_TOKEN=
BROKER_AUTONOMOUS_INGRESS_TOKEN=
BROKER_EXCHANGE_TOKEN=
JJ_MAX_TOOL_ITERATIONS=4

# Optional organic participation
JJ_SPONTANEOUS_ENABLED=true
JJ_SPONTANEOUS_MIN_MESSAGES=8
JJ_SPONTANEOUS_MAX_MESSAGES=24
JJ_SPONTANEOUS_COOLDOWN_MINUTES=20
JJ_SPONTANEOUS_MAX_PER_HOUR=2
JJ_SPONTANEOUS_MIN_CHARS=12

# Optional generic behavior modes. Disabled by default for backwards compatibility.
# Modes: manual, observe, auto, quiet. Auto is event-driven by Discord messages.
BEHAVIOR_MODE_ENABLED=false
BEHAVIOR_MODE_DEFAULT=manual
BEHAVIOR_MODE_STATE_PATH=state/behavior-mode.json
BEHAVIOR_MODE_AUTO_COOLDOWN_SECONDS=180
BEHAVIOR_MODE_AUTO_MAX_REPLIES_PER_HOUR=8

# Optional MCP control server for behavior modes. Use a private bearer token and
# expose it remotely only through a trusted tunnel or deployment boundary.
MCP_CONTROL_ENABLED=false
MCP_CONTROL_HOST=127.0.0.1
MCP_CONTROL_PORT=3000
MCP_CONTROL_BEARER_TOKEN=
MCP_CONTROL_WAKE_TOKEN=
MCP_CAPABILITY_INTROSPECTION_TOKEN=

# Participation settings live primarily in config.json. These remain available
# as environment fallbacks for container and managed deployments.
JJ_PARTICIPATION_ENABLED=true
JJ_PARTICIPATION_BUDGET_MAX_RESPONSES=12
JJ_PARTICIPATION_BUDGET_WINDOW_MINUTES=10
JJ_PARTICIPATION_CONVERSATION_TURNS=5
JJ_PARTICIPATION_CONVERSATION_IDLE_MINUTES=10
JJ_PARTICIPATION_COOLDOWN_BASE_SECONDS=3
JJ_PARTICIPATION_COOLDOWN_MULTIPLIER=2
JJ_PARTICIPATION_COOLDOWN_MAX_SECONDS=60
JJ_PARTICIPATION_COOLDOWN_DECAY_SECONDS=120
JJ_PARTICIPATION_COOLDOWN_RESET_MINUTES=10
JJ_PARTICIPATION_AUTOBAN_ENABLED=true
JJ_PARTICIPATION_AUTOBAN_TRIGGERS=8
JJ_PARTICIPATION_AUTOBAN_WINDOW_SECONDS=20
JJ_PARTICIPATION_AUTOBAN_COOLDOWN_REJECTIONS=4
JJ_PARTICIPATION_AUTOBAN_DURATION_MINUTES=10
JJ_PARTICIPATION_AUTOBAN_REPEAT_WINDOW_HOURS=24
JJ_PARTICIPATION_AUTOBAN_REPEAT_DURATION_MINUTES=60
JJ_PARTICIPATION_AUTOBAN_MAX_DURATION_MINUTES=360
JJ_PARTICIPATION_STATE_PATH=state/participation-state.json
JJ_PARTICIPATION_AUDIT_ENABLED=true
JJ_PARTICIPATION_AUDIT_PATH=logs/participation-events.jsonl
JJ_PARTICIPATION_AUDIT_MAX_BYTES=5242880
JJ_PARTICIPATION_AUDIT_MAX_ARCHIVES=5

# Optional owner-DM decision heartbeat. Requires MODEL_PROVIDER=none, chat relay,
# one immutable numeric owner ID, and global auto behavior mode. A heartbeat queues
# a decision opportunity; it never sends a DM by itself.
JJ_OWNER_HEARTBEAT_ENABLED=false
JJ_OWNER_HEARTBEAT_USER_ID=
JJ_OWNER_HEARTBEAT_MIN_MINUTES=60
JJ_OWNER_HEARTBEAT_MAX_MINUTES=180
JJ_OWNER_HEARTBEAT_RECENT_INTERACTION_MINUTES=30
JJ_OWNER_HEARTBEAT_CONTEXT_MESSAGES=8

# Deterministic owner controls; maintenance makes the companion owner-only before inference. Supervised restart is
# disabled by default; enable it only behind WinSW, systemd, Docker, or equivalent.
JJ_RUNTIME_CONTROL_ENABLED=true
JJ_RUNTIME_CONTROL_STATE_PATH=state/runtime-control.json
JJ_RUNTIME_CONTROL_RESTART_ENABLED=false
JJ_RUNTIME_CONTROL_SHUTDOWN_ENABLED=false
JJ_RUNTIME_CONTROL_RESTART_DELAY_MS=750
JJ_RUNTIME_CONTROL_RESTART_EXIT_CODE=75
JJ_RUNTIME_CONTROL_USERNAME_FALLBACK=true
JJ_RUNTIME_CONTROL_AUDIT_ENABLED=true
JJ_RUNTIME_CONTROL_AUDIT_PATH=logs/runtime-control.jsonl
JJ_RUNTIME_CONTROL_AUDIT_MAX_BYTES=5242880
JJ_RUNTIME_CONTROL_AUDIT_MAX_ARCHIVES=5
