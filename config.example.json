{
  "discord": {
    "allowedGuildIds": [],
    "allowedChannelIds": [],
    "botFilter": {
      "mode": "allowlist",
      "userIds": []
    },
    "botLoopGuard": {
      "enabled": true,
      "maxConsecutive": 5,
      "cooldownSeconds": 180
    },
    "emojiPalette": [
      "<:example_one:123456789012345678>",
      "<a:example_two:234567890123456789>"
    ],
    "watchdog": {
      "enabled": false,
      "graceSeconds": 90,
      "checkIntervalSeconds": 15
    }
  },
  "permissions": {
    "owner": {
      "allowedUserIds": [],
      "allowedUsernames": []
    },
    "memory": {
      "allowedUserIds": [],
      "allowedUsernames": []
    }
  },
  "participation": {
    "enabled": true,
    "budget": {
      "maxResponses": 12,
      "windowMinutes": 10
    },
    "conversation": {
      "turns": 5,
      "idleMinutes": 10
    },
    "cooldown": {
      "baseSeconds": 3,
      "multiplier": 2,
      "maxSeconds": 60,
      "decaySeconds": 120,
      "resetMinutes": 10
    },
    "autoban": {
      "enabled": true,
      "triggers": 8,
      "windowSeconds": 20,
      "cooldownRejections": 4,
      "durationMinutes": 10,
      "repeatWindowHours": 24,
      "repeatDurationMinutes": 60,
      "maxDurationMinutes": 360
    },
    "statePath": "state/participation-state.json"
  },
  "ownerHeartbeat": {
    "enabled": false,
    "ownerUserId": "",
    "minMinutes": 60,
    "maxMinutes": 180,
    "recentInteractionMinutes": 30,
    "contextMessages": 8
  },
  "runtimeControl": {
    "enabled": true,
    "statePath": "state/runtime-control.json",
    "restartEnabled": false,
    "shutdownEnabled": false,
    "restartDelayMs": 750,
    "restartExitCode": 75,
    "allowUsernameFallback": true
  },
  "logging": {
    "participation": {
      "enabled": true,
      "path": "logs/participation-events.jsonl",
      "maxBytes": 5242880,
      "maxArchives": 5
    },
    "runtimeControl": {
      "enabled": true,
      "path": "logs/runtime-control.jsonl",
      "maxBytes": 5242880,
      "maxArchives": 5
    },
    "memory": {
      "enabled": true,
      "path": "logs/memory-events.jsonl",
      "maxBytes": 5242880,
      "maxArchives": 5
    }
  },
  "xPrefetch": {
    "enabled": true,
    "maxPosts": 2,
    "maxChars": 1200
  },
  "vision": {
    "mode": "sidecar",
    "nativeModels": []
  },
  "chatRelay": {
    "enabled": false,
    "statePath": "state/chat-relay.json",
    "ttlSeconds": 86400,
    "maxItems": 50,
    "maxContextChars": 12000,
    "leaseSeconds": 120,
    "maxAttempts": 3,
    "ownerPriorityBurst": 3,
    "humanPriorityBurst": 5,
    "maxImageAttachments": 4,
    "maxAudioAttachments": 2,
    "maxTextAttachments": 4,
    "maxAttachmentBytes": 8000000,
    "maxAudioAttachmentBytes": 8000000,
    "audioFetchTimeoutMs": 30000
  },
  "capabilityBroker": {
    "enabled": false,
    "baseUrl": "http://127.0.0.1:3400",
    "ownerAudiences": ["filesystem", "execution", "discord"],
    "publicAudiences": ["discord"],
    "autonomousAudiences": ["filesystem", "execution", "discord"],
    "timeoutMs": 5000,
    "minGrantRemainingSeconds": 15
  },
  "memory": {
    "enabled": false,
    "storePath": "state/memory.jsonl",
    "maxRecords": 5000,
    "maxPerUser": 300,
    "retentionDays": 90,
    "maxTextChars": 300,
    "injection": {
      "maxItems": 60,
      "maxChars": 12000
    },
    "extraction": {
      "enabled": false,
      "captureMode": "observation",
      "provider": "",
      "model": "",
      "baseUrl": "",
      "idleMinutes": 10,
      "minMessages": 4,
      "maxMessages": 40,
      "maxTranscriptChars": 8000,
      "maxFacts": 5,
      "maxOutputTokens": 800,
      "checkIntervalSeconds": 60
    }
  }
}
